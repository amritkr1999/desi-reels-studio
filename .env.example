# ==============================================================================
# DesiReels Studio — Environment Configuration (.env)
# Copy this file to .env and fill in your values where appropriate.
# NOTE: Never commit .env or real credentials to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Pipeline Execution & Safety
# ------------------------------------------------------------------------------
# Default safety mode: DRY_RUN=true prevents actual network publishing.
# Set DRY_RUN=false only when you are ready to publish real reels/shorts.
DRY_RUN=true
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata
DATABASE_PATH=data/studio.db

# ------------------------------------------------------------------------------
# 2. Local AI & Scripting (Ollama)
# ------------------------------------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=llama3.2-vision
OLLAMA_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# 3. Audio & Subtitle Engine
# ------------------------------------------------------------------------------
# TTS Engine: "auto", "kokoro", "chatterbox", or "say" (native macOS fallback)
TTS_ENGINE=auto
# Recommended macOS voice: "Rishi" (Indian English) or "Samantha" / "Alex"
MACOS_SAY_VOICE=Rishi
# Whisper model for word-level subtitle alignment: "tiny.en", "base.en", "small.en"
WHISPER_MODEL=base.en
# Speech rate in words per minute (optimal for 30s reels: 150-165 WPM)
TARGET_WPM=160

# ------------------------------------------------------------------------------
# 4. Visual Media & B-Roll
# ------------------------------------------------------------------------------
# Pexels API Key for free curated vertical stock B-roll (optional)
# Register free at: https://www.pexels.com/api/
PEXELS_API_KEY=

# ------------------------------------------------------------------------------
# 5. YouTube Shorts Publishing (Google Data API v3)
# ------------------------------------------------------------------------------
# Client secrets file downloaded from Google Cloud Console (OAuth 2.0 Client ID)
YOUTUBE_CLIENT_SECRETS_FILE=credentials/youtube_client_secret.json
# Generated OAuth token file (created after first-time manual browser auth)
YOUTUBE_TOKEN_FILE=credentials/youtube_token.json
# Default privacy status: "private", "unlisted", or "public"
YOUTUBE_PRIVACY_STATUS=private

# ------------------------------------------------------------------------------
# 6. Instagram Reels Publishing (Meta Graph API)
# ------------------------------------------------------------------------------
# Instagram Professional/Creator Account ID
INSTAGRAM_ACCOUNT_ID=
# Long-lived Meta User/Page Access Token with instagram_content_publish permission
INSTAGRAM_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 7. Facebook Reels Publishing (Meta Page Video Reels API)
# ------------------------------------------------------------------------------
# Facebook Page ID
FACEBOOK_PAGE_ID=
# Page Access Token with pages_manage_posts and pages_read_engagement permissions
FACEBOOK_PAGE_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 8. Local Dashboard Configuration
# ------------------------------------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8500
